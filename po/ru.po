msgid "Broken Symlink"
msgstr "Битый симлинк"

msgid "Target file does not exist, but link path was copied to clipboard"
msgstr "Конечный файл не существует, но ссылка всё равно скопирована в буфер"

msgid "Copy Folder Path"
msgstr "Копировать путь к папке"

